---
interface Props {
  active: 'bookings' | 'tasks' | 'accounting';
}
const { active } = Astro.props;
---

<nav class="app-nav">
  <a
    class={`app-nav-item${active === 'bookings' ? ' app-nav-active' : ''}`}
    href="/dashboard"
    title="Bookings"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
    <span class="app-nav-label">Bookings</span>
  </a>

  <a
    class={`app-nav-item${active === 'tasks' ? ' app-nav-active' : ''}`}
    href="/admin-tasks"
    title="Tasks"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 11 12 14 22 4"/>
      <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
    </svg>
    <span class="app-nav-label">Tasks</span>
  </a>

  <a
    class={`app-nav-item${active === 'accounting' ? ' app-nav-active' : ''}`}
    href="/accounting"
    title="Accounting"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="1" x2="12" y2="23"/>
      <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
    </svg>
    <span class="app-nav-label">Acct</span>
  </a>
</nav>

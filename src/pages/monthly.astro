---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_NUMBER = '66639407272';

const rooms = [
  {
    name: 'The Nest',
    images: [
      '/images/rooms/kinhaus-nest-1.jpg',
      '/images/rooms/kinhaus-nest-2.jpg',
      '/images/rooms/kinhaus-nest-3.jpg',
      '/images/rooms/kinhaus-nest-bathroom-1.jpg',
      '/images/rooms/kinhaus-nest-bathroom-2.jpg',
    ],
    description: 'A private retreat at the top of the house with panoramic views and its own bathroom.',
    features: ['King bed', 'Ensuite bathroom', 'Panoramic views', 'Private balcony'],
    was: 105000,
    monthly: 35000,
    threeMonth: 28000,
    save: 67,
    approx: '≈ €950 · $1,030',
  },
  {
    name: 'The Explorer',
    images: [
      '/images/rooms/kinhaus-master-teak-headboard.jpg',
      '/images/rooms/kinhaus-master-desk-and-windows.jpg',
      '/images/rooms/kinhaus-master-walk-in-closet-mirrored-wardrobes.jpg',
      '/images/rooms/kinhaus-master-headboard-detail.jpg',
      '/images/rooms/kinhaus-master-bathroom-entrance.jpg',
    ],
    description: 'Spacious lower-floor suite with a king-size bed, full-size wardrobe, and sunrise views.',
    features: ['King bed', 'Walk-in wardrobe', 'Sunrise views', 'Desk'],
    was: 72000,
    monthly: 28000,
    threeMonth: 22400,
    save: 61,
    approx: '≈ €760 · $820',
  },
  {
    name: 'The Nomad',
    images: [
      '/images/rooms/kinhaus-nomad-bedroom-wide-angle.jpg',
      '/images/rooms/kinhaus-nomad-bedroom-bed-and-desk.jpg',
      '/images/rooms/kinhaus-nomad-desk-monitor-and-speakers.jpg',
      '/images/rooms/kinhaus-nomad-bedroom-desk-setup.jpg',
      '/images/rooms/kinhaus-nomad-desk-closeup.jpg',
    ],
    description: 'A cozy, workspace-ready room built for remote work with a dedicated desk setup.',
    features: ['King bed', 'Dedicated desk', 'Monitor setup', 'Shared balcony'],
    was: 50400,
    monthly: 25000,
    threeMonth: 20000,
    save: 50,
    approx: '≈ €680 · $740',
  },
];

const included = ['Infinity pool', '500+ Mbps WiFi', 'Fully equipped kitchen', 'Open living & dining', 'Workspace-ready desks', 'Air conditioning'];

const commonAreas = [
  { src: '/images/property/kinhaus-infinity-pool-jungle-view.jpg', alt: 'Infinity pool with jungle view' },
  { src: '/images/property/kinhaus-living-room-glass-walls.jpg', alt: 'Living room with glass walls' },
  { src: '/images/property/kinhaus-kitchen-and-dining.jpg', alt: 'Kitchen and dining area' },
  { src: '/images/property/kinhaus-workspace-and-living-room.jpg', alt: 'Workspace and living room' },
  { src: '/images/property/kinhaus-dining-area-pool-view.jpg', alt: 'Dining area with pool view' },
  { src: '/images/property/kinhaus-pool-deck-and-facade.jpg', alt: 'Pool deck and villa facade' },
];

function waLink(room: string) {
  return `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hi! I'm interested in a monthly stay in ${room} at Kin Haus.`)}`;
}
---

<BaseLayout
  title="Monthly Stays -- Kin Haus Co-Living Villa, Koh Phangan"
  description="Monthly rooms at Kin Haus co-living villa in Koh Phangan from 25,000 THB per month. Low season Apr-Oct, up to 67% off. Infinity pool, 500+ Mbps WiFi, small community of remote workers."
  canonicalPath="/monthly"
>
  <style>
    .lp-top {
      display: flex; justify-content: space-between; align-items: baseline;
      padding: 20px 40px;
      border-bottom: 1px solid #e4e2de;
    }
    .lp-wordmark {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 700; font-size: 20px; letter-spacing: 0.02em;
    }
    .lp-wordmark span { color: var(--accent); }
    .lp-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
      color: #64645f;
    }
    .monthly-hero {
      position: relative;
      min-height: 440px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }
    .monthly-hero img {
      position: absolute; inset: 0;
      width: 100%; height: 100%; object-fit: cover;
    }
    .monthly-hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(10,16,13,0.72) 0%, rgba(10,16,13,0.15) 55%, rgba(10,16,13,0) 100%);
    }
    .monthly-hero-content {
      position: relative;
      padding: 60px 40px 48px;
      max-width: 1000px;
      margin: 0 auto;
      width: 100%;
      color: white;
    }
    .monthly-hero-badge {
      display: inline-block;
      background: var(--accent);
      color: white;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 500;
      padding: 7px 16px;
      border-radius: 100px;
      margin-bottom: 18px;
    }
    .monthly-hero h1 {
      font-size: 44px;
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 12px;
    }
    .monthly-hero-sub {
      font-size: 16px;
      font-weight: 300;
      opacity: 0.92;
      max-width: 560px;
      line-height: 1.5;
    }

    .monthly-page { padding: 48px 40px 72px; max-width: 1000px; margin: 0 auto; }

    .monthly-intro {
      font-size: 15px;
      color: #52524e;
      line-height: 1.65;
      max-width: 720px;
      margin-bottom: 44px;
    }

    .monthly-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 48px; }

    .m-room {
      border: 1px solid #e4e2de; border-radius: 12px; background: white;
      overflow: hidden; display: flex; flex-direction: column;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .m-room:hover { border-color: #ccc; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
    .m-gallery-main { height: 210px; background: var(--warm); overflow: hidden; cursor: zoom-in; }
    .m-gallery-main img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .m-gallery-thumbs {
      display: flex; gap: 5px; padding: 8px 10px 0;
    }
    .m-thumb {
      flex: 1; height: 44px; padding: 0;
      border: 2px solid transparent; border-radius: 6px;
      overflow: hidden; cursor: pointer; background: var(--warm);
      transition: border-color 0.12s, opacity 0.12s;
      opacity: 0.75;
    }
    .m-thumb:hover { opacity: 1; }
    .m-thumb.active { border-color: var(--accent); opacity: 1; }
    .m-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .m-room-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
    .m-room-name { font-weight: 600; font-size: 19px; margin-bottom: 6px; }
    .m-room-desc { font-size: 13px; color: #64645f; line-height: 1.5; margin-bottom: 14px; }
    .m-room-feats { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
    .m-feat {
      padding: 3px 8px; background: var(--paper); border: 1px solid #e4e2de;
      border-radius: 4px; font-size: 10px; color: #64645f;
    }
    .m-room-pricing { margin-top: auto; border-top: 1px solid #f0eeeb; padding-top: 14px; margin-bottom: 16px; }
    .m-price-was {
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
      color: #9b9993; text-decoration: line-through;
    }
    .m-price-save {
      font-family: 'JetBrains Mono', monospace; font-size: 11px;
      color: var(--accent); font-weight: 500; margin-left: 6px;
    }
    .m-price-now {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 700; font-size: 28px; color: var(--accent);
      line-height: 1.15; margin-top: 4px;
    }
    .m-price-now small { font-size: 14px; font-weight: 500; color: #52524e; }
    .m-price-approx {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; color: #8b8b85; margin-top: 4px;
    }
    .m-price-3mo {
      display: inline-block;
      margin-top: 8px;
      background: #e8f4ec;
      color: var(--accent);
      font-size: 11.5px;
      font-weight: 500;
      padding: 4px 9px;
      border-radius: 5px;
      line-height: 1.4;
    }
    .m-room-cta {
      display: block; text-align: center;
      background: var(--accent); color: white;
      font-size: 13px; font-weight: 500;
      padding: 11px 16px; border-radius: 8px;
      text-decoration: none;
      transition: opacity 0.15s;
    }
    .m-room-cta:hover { opacity: 0.9; }

    .ca-title {
      font-size: 26px; font-weight: 600; margin-bottom: 6px;
    }
    .ca-sub { font-size: 14px; color: #64645f; margin-bottom: 20px; line-height: 1.5; }
    .ca-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
      margin-bottom: 48px;
    }
    .ca-photo {
      height: 200px; padding: 0; border: none; border-radius: 10px;
      overflow: hidden; cursor: zoom-in; background: var(--warm);
    }
    .ca-photo img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 0.2s;
    }
    .ca-photo:hover img { transform: scale(1.04); }

    .monthly-note {
      font-size: 12.5px; color: #8b8b85; margin: -34px 0 48px;
      line-height: 1.5;
    }

    .lb {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(10, 14, 11, 0.93);
      display: flex; align-items: center; justify-content: center;
    }
    .lb[hidden] { display: none; }
    .lb-img {
      max-width: 88vw; max-height: 86vh;
      object-fit: contain; border-radius: 8px;
    }
    .lb-btn {
      position: absolute; background: rgba(255,255,255,0.1); border: none;
      color: white; cursor: pointer; border-radius: 100px;
      width: 44px; height: 44px; font-size: 22px; line-height: 1;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s;
    }
    .lb-btn:hover { background: rgba(255,255,255,0.22); }
    .lb-close { top: 20px; right: 20px; }
    .lb-prev { left: 20px; top: 50%; transform: translateY(-50%); }
    .lb-next { right: 20px; top: 50%; transform: translateY(-50%); }

    .monthly-included {
      background: var(--warm); border-radius: 12px;
      padding: 24px 32px; margin-bottom: 48px;
      display: flex; align-items: center; gap: 16px 32px; flex-wrap: wrap;
    }
    .monthly-included-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      color: #64645f;
    }
    .monthly-included-item { font-size: 14px; color: var(--ink); white-space: nowrap; }
    .monthly-included-item::before { content: '\2713'; color: var(--accent); margin-right: 7px; font-weight: 600; }

    .monthly-cta {
      background: var(--ink); color: white; border-radius: 14px;
      padding: 40px 44px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
      flex-wrap: wrap;
    }
    .monthly-cta-title { font-size: 24px; font-weight: 600; margin-bottom: 6px; font-family: 'Bricolage Grotesque', sans-serif; }
    .monthly-cta-sub { font-size: 13px; opacity: 0.75; font-weight: 300; max-width: 420px; line-height: 1.5; }
    .monthly-cta-btn {
      display: inline-flex; align-items: center; gap: 10px;
      background: #25d366; color: #0b3d24;
      font-size: 15px; font-weight: 600;
      padding: 14px 26px; border-radius: 10px;
      text-decoration: none; white-space: nowrap;
      transition: opacity 0.15s;
    }
    .monthly-cta-btn:hover { opacity: 0.9; }

    @media (max-width: 768px) {
      .monthly-hero { min-height: 360px; }
      .monthly-hero h1 { font-size: 32px; }
      .monthly-hero-content { padding: 48px 24px 36px; }
      .monthly-page { padding: 36px 24px 56px; }
      .monthly-grid { grid-template-columns: 1fr; }
      .ca-grid { grid-template-columns: 1fr 1fr; }
      .ca-photo { height: 140px; }
      .monthly-cta { padding: 32px 28px; }
    }
  </style>

  <div class="lp-top">
    <span class="lp-wordmark">KIN <span>HAUS</span></span>
    <span class="lp-tag">Monthly stays · Low season Apr - Oct</span>
  </div>

  <section class="monthly-hero">
    <img src="/images/property/kinhaus-pool-mountain-panorama.jpg" alt="Kin Haus infinity pool with mountain view">
    <div class="monthly-hero-overlay"></div>
    <div class="monthly-hero-content">
      <span class="monthly-hero-badge">Save up to 67% monthly</span>
      <h1>A month on the island, at home.</h1>
      <p class="monthly-hero-sub">A boutique co-living villa on the hillside of Thongsala, Koh Phangan. Three private guest rooms, an infinity pool, and a small community of remote workers and creatives.</p>
    </div>
  </section>

  <div class="monthly-page">
    <p class="monthly-intro">
      Stay a month and settle in properly. Monthly guests get our best rates of the year: up to 67% off low season prices from April through October. Wake up to jungle views, swim before your first call, and work on 500+ Mbps WiFi. One home, four rooms, and people worth sharing a table with. Your host stays in one of the rooms, so the house is always looked after. Staying three months or longer? Take an extra 20% off on top.
    </p>

    <div class="monthly-grid">
      {rooms.map((room) => (
        <div class="m-room">
          <div class="m-gallery">
            <div class="m-gallery-main"><img src={room.images[0]} alt={room.name} loading="lazy"></div>
            <div class="m-gallery-thumbs">
              {room.images.map((img, i) => (
                <button type="button" class={`m-thumb${i === 0 ? ' active' : ''}`} data-src={img} aria-label={`${room.name} photo ${i + 1}`}>
                  <img src={img} alt="" loading="lazy">
                </button>
              ))}
            </div>
          </div>
          <div class="m-room-body">
            <div class="m-room-name">{room.name}</div>
            <p class="m-room-desc">{room.description}</p>
            <div class="m-room-feats">
              {room.features.map((f) => <span class="m-feat">{f}</span>)}
            </div>
            <div class="m-room-pricing">
              <span class="m-price-was" data-thb={room.was} data-price-tpl="{price}">&#x0E3F;{room.was.toLocaleString()}</span>
              <span class="m-price-save">-{room.save}%</span>
              <div class="m-price-now"><span data-thb={room.monthly} data-price-tpl="{price}">&#x0E3F;{room.monthly.toLocaleString()}</span> <small>/ month</small></div>
              <div class="m-price-approx">{room.approx}</div>
              <div class="m-price-3mo">3+ months: <span data-thb={room.threeMonth} data-price-tpl="{price}">&#x0E3F;{room.threeMonth.toLocaleString()}</span>/mo (extra 20% off)</div>
            </div>
            <a href={waLink(room.name)} target="_blank" rel="noopener" class="m-room-cta">Reserve on WhatsApp</a>
          </div>
        </div>
      ))}
    </div>

    <h2 class="ca-title">The shared home</h2>
    <p class="ca-sub">Everything beyond your door: an infinity pool, a full kitchen, open living and dining spaces, and workspaces shared between just four rooms. Your host stays in one of them.</p>
    <div class="ca-grid">
      {commonAreas.map((photo) => (
        <button type="button" class="ca-photo"><img src={photo.src} alt={photo.alt} loading="lazy"></button>
      ))}
    </div>

    <div class="monthly-included">
      <span class="monthly-included-label">Every stay includes</span>
      {included.map((item) => <span class="monthly-included-item">{item}</span>)}
    </div>
    <p class="monthly-note">Note: electricity and cleaning are not included in the monthly price and are billed separately.</p>

    <div class="monthly-cta">
      <div>
        <div class="monthly-cta-title">Book direct and skip the platform fees</div>
        <p class="monthly-cta-sub">Limited to three rooms. April to October, minimum 28 nights. Bank transfer or cash.</p>
      </div>
      <a href={waLink('one of the rooms')} target="_blank" rel="noopener" class="monthly-cta-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp +66639407272
      </a>
    </div>
  </div>

  <div class="lb" id="lightbox" hidden>
    <button type="button" class="lb-btn lb-close" aria-label="Close">&#x2715;</button>
    <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">&#x2039;</button>
    <img class="lb-img" src="" alt="">
    <button type="button" class="lb-btn lb-next" aria-label="Next photo">&#x203A;</button>
  </div>

  <script>
    document.querySelectorAll('.m-thumb').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const gallery = thumb.closest('.m-gallery');
        if (!gallery) return;
        const main = gallery.querySelector('.m-gallery-main img');
        if (main) main.src = thumb.dataset.src;
        gallery.querySelectorAll('.m-thumb').forEach((t) => t.classList.toggle('active', t === thumb));
      });
    });

    // Lightbox
    const lb = document.getElementById('lightbox');
    const lbImg = lb.querySelector('.lb-img');
    let lbImages = [];
    let lbIndex = 0;

    function lbOpen(images, index) {
      lbImages = images;
      lbIndex = index;
      lbShow();
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function lbShow() {
      lbImg.src = lbImages[lbIndex];
    }
    function lbClose() {
      lb.hidden = true;
      document.body.style.overflow = '';
    }
    function lbStep(dir) {
      lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
      lbShow();
    }

    // Room gallery main image opens lightbox at the active photo
    document.querySelectorAll('.m-gallery').forEach((gallery) => {
      const main = gallery.querySelector('.m-gallery-main');
      main.addEventListener('click', () => {
        const thumbs = [...gallery.querySelectorAll('.m-thumb')];
        const images = thumbs.map((t) => t.dataset.src);
        const active = thumbs.findIndex((t) => t.classList.contains('active'));
        lbOpen(images, active >= 0 ? active : 0);
      });
    });

    // Common area photos open lightbox as one set
    const caPhotos = [...document.querySelectorAll('.ca-photo img')];
    const caImages = caPhotos.map((img) => img.getAttribute('src'));
    caPhotos.forEach((img, i) => {
      img.closest('.ca-photo').addEventListener('click', () => lbOpen(caImages, i));
    });

    lb.querySelector('.lb-close').addEventListener('click', lbClose);
    lb.querySelector('.lb-prev').addEventListener('click', (e) => { e.stopPropagation(); lbStep(-1); });
    lb.querySelector('.lb-next').addEventListener('click', (e) => { e.stopPropagation(); lbStep(1); });
    lb.addEventListener('click', (e) => { if (e.target === lb) lbClose(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') lbClose();
      if (e.key === 'ArrowLeft') lbStep(-1);
      if (e.key === 'ArrowRight') lbStep(1);
    });
  </script>
</BaseLayout>

  <script is:inline>
    /* ─── Labels & colours ─── */
    const EXP_CAT_LABELS = {
      supplies:    'Supplies',
      food:        'Food & groceries',
      utilities:   'Utilities',
      maintenance: 'Maintenance',
      travel:      'Travel',
      fees:        'Fees & subscriptions',
      other:       'Other',
    };
    const INC_CAT_LABELS = {
      airbnb:         'Airbnb / OTA',
      direct_booking: 'Direct booking',
      coworking:      'Coworking',
      monitor_rental: 'Monitor rental',
      transfer:       'Transfer / other',
      other:          'Other income',
    };
    const DEP_LABELS = {
      wise:           'Wise',
      cash:           'Cash',
      business:       'Business bank',
      personal_other: 'Personal / other',
      other:          'Other',
    };
    const DEP_ICONS = { wise: '💳', cash: '💵', business: '🏦', personal_other: '👤', other: '📦' };
    const SCOPE_LABEL = { business: 'Business', personal: 'Personal' };

    /* Category colour palettes */
    const EXP_CAT_COLORS = {
      supplies:    '#f97316',
      food:        '#ca8a04',
      utilities:   '#3b82f6',
      maintenance: '#ef4444',
      travel:      '#8b5cf6',
      fees:        '#6366f1',
      other:       '#9ca3af',
    };
    const INC_CAT_COLORS = {
      airbnb:         '#ec4899',
      direct_booking: '#22c55e',
      coworking:      '#14b8a6',
      monitor_rental: '#06b6d4',
      transfer:       '#3b82f6',
      other:          '#9ca3af',
    };

    function catColor(key, isInc) {
      return isInc ? (INC_CAT_COLORS[key] || '#9ca3af') : (EXP_CAT_COLORS[key] || '#9ca3af');
    }

    /* ─── Helpers ─── */
    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
    }
    function fmtMoney(n) {
      return new Intl.NumberFormat('en-TH', { maximumFractionDigits: 0 }).format(Math.round(n || 0));
    }
    function fmtDate(s) {
      if (!s) return '';
      const parts = s.split('-');
      if (parts.length < 3) return s;
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const d = parseInt(parts[2], 10);
      const m = parseInt(parts[1], 10) - 1;
      const y = parts[0];
      return months[m] + ' ' + d + ', ' + y;
    }
    function hexAlpha(hex, pct) {
      /* pct 0–100, returns hex with 2-digit alpha */
      const a = Math.round(pct / 100 * 255).toString(16).padStart(2, '0');
      return hex + a;
    }

    /* ─── DOM refs ─── */
    const els = {
      alerts:          document.getElementById('alerts'),
      filterFrom:      document.getElementById('filter-from'),
      filterTo:        document.getElementById('filter-to'),
      btnApply:        document.getElementById('btn-apply'),
      btnClear:        document.getElementById('btn-clear-range'),
      btnAddExp:       document.getElementById('btn-add-expense'),
      btnAddInc:       document.getElementById('btn-add-income'),
      paneOverview:    document.getElementById('pane-overview'),
      paneExp:         document.getElementById('pane-expenses'),
      paneInc:         document.getElementById('pane-income'),
      overviewHero:    document.getElementById('overview-hero'),
      overviewKpi:     document.getElementById('overview-kpi'),
      overviewRatio:   document.getElementById('overview-ratio'),
      overviewDep:     document.getElementById('overview-deposits'),
      expList:         document.getElementById('expense-list'),
      expSummaryBar:   document.getElementById('exp-summary-bar'),
      expCats:         document.getElementById('exp-cats'),
      incList:         document.getElementById('income-list'),
      incSummaryBar:   document.getElementById('inc-summary-bar'),
      incCats:         document.getElementById('inc-cats'),
      filterExpCat:    document.getElementById('filter-exp-cat'),
      filterExpScope:  document.getElementById('filter-exp-scope'),
      filterIncCat:    document.getElementById('filter-inc-cat'),
      filterIncDep:    document.getElementById('filter-inc-dep'),
      filterIncScope:  document.getElementById('filter-inc-scope'),
      modalExp:        document.getElementById('modal-exp-backdrop'),
      modalInc:        document.getElementById('modal-inc-backdrop'),
      modalExpTitle:   document.getElementById('modal-exp-title'),
      modalIncTitle:   document.getElementById('modal-inc-title'),
      formExp:         document.getElementById('form-expense'),
      formInc:         document.getElementById('form-income'),
      fExpId:          document.getElementById('f-exp-id'),
      fExpDate:        document.getElementById('f-exp-date'),
      fExpAmount:      document.getElementById('f-exp-amount'),
      fExpVendor:      document.getElementById('f-exp-vendor'),
      fExpCategory:    document.getElementById('f-exp-category'),
      fExpScope:       document.getElementById('f-exp-scope'),
      fExpNotes:       document.getElementById('f-exp-notes'),
      fExpFile:        document.getElementById('f-exp-file'),
      fIncId:          document.getElementById('f-inc-id'),
      fIncDate:        document.getElementById('f-inc-date'),
      fIncAmount:      document.getElementById('f-inc-amount'),
      fIncDesc:        document.getElementById('f-inc-desc'),
      fIncCategory:    document.getElementById('f-inc-category'),
      fIncDeposit:     document.getElementById('f-inc-deposit'),
      fIncScope:       document.getElementById('f-inc-scope'),
      fIncNotes:       document.getElementById('f-inc-notes'),
      fIncFile:        document.getElementById('f-inc-file'),
      btnExpCancel:    document.getElementById('btn-exp-cancel'),
      btnIncCancel:    document.getElementById('btn-inc-cancel'),
    };

    let activeTab = 'overview';

    function showAlert(msg, isErr) {
      els.alerts.innerHTML = '<div class="alert ' + (isErr ? 'alert-error' : 'alert-success') + '" style="margin:12px 20px;">' + esc(msg) + '</div>';
      setTimeout(function () { els.alerts.innerHTML = ''; }, 4000);
    }

    function fillSelect(sel, keys, labels) {
      const cur = sel.value;
      sel.innerHTML = '<option value="">All</option>';
      for (const k of keys) {
        const o = document.createElement('option');
        o.value = k; o.textContent = labels[k] || k;
        sel.appendChild(o);
      }
      if (cur) sel.value = cur;
    }
    function fillSelectRequired(sel, keys, labels) {
      const cur = sel.value;
      sel.innerHTML = '';
      for (const k of keys) {
        const o = document.createElement('option');
        o.value = k; o.textContent = labels[k] || k;
        sel.appendChild(o);
      }
      if (cur) sel.value = cur;
    }

    function queryRange() {
      const p = new URLSearchParams();
      if (els.filterFrom.value) p.set('from', els.filterFrom.value);
      if (els.filterTo.value) p.set('to', els.filterTo.value);
      return p;
    }

    /* ─── Render category chips ─── */
    function renderCatChips(container, byCategory, labels, colors, onSelect) {
      if (!byCategory || !Object.keys(byCategory).length) {
        container.innerHTML = '';
        return;
      }
      const total = Object.values(byCategory).reduce(function (s, v) { return s + (v.total || 0); }, 0);
      const sorted = Object.entries(byCategory).sort(function (a, b) { return b[1].total - a[1].total; });
      container.innerHTML = '<div class="acct-section-title">By category</div>';
      const wrap = document.createElement('div');
      wrap.className = 'acct-cat-chips';
      sorted.forEach(function ([k, v]) {
        const color = colors[k] || '#9ca3af';
        const chip = document.createElement('div');
        chip.className = 'acct-cat-chip';
        chip.style.setProperty('--chip-color', color);
        chip.style.borderColor = hexAlpha(color, 25);
        chip.style.background = hexAlpha(color, 8);
        chip.innerHTML =
          '<span class="acct-chip-dot"></span>' +
          '<span class="acct-chip-label">' + esc(labels[k] || k) + '</span>' +
          '<span class="acct-chip-amount">฿' + fmtMoney(v.total) + '</span>';
        chip.title = v.count + ' item' + (v.count !== 1 ? 's' : '');
        chip.addEventListener('click', function () {
          onSelect(chip.classList.contains('selected') ? '' : k);
          container.querySelectorAll('.acct-cat-chip').forEach(function (c) { c.classList.remove('selected'); });
          if (!chip.classList.contains('selected')) chip.classList.add('selected');
          else chip.classList.remove('selected');
        });
        wrap.appendChild(chip);
      });
      container.appendChild(wrap);
    }

    /* ─── Empty state helper ─── */
    function emptyState(icon, title, sub) {
      return '<div class="acct-empty"><div class="acct-empty-icon">' + icon + '</div>' +
        '<div class="acct-empty-title">' + esc(title) + '</div>' +
        '<div class="acct-empty-sub">' + esc(sub) + '</div></div>';
    }

    /* ─── Load overview ─── */
    async function loadSummary() {
      const res = await fetch('/api/accounting/summary?' + queryRange().toString());
      const data = await res.json();
      if (!res.ok) { showAlert(data.error || 'Summary failed', true); return; }

      const s = data.summary;
      const b = s.business;
      const p = s.personal;
      const isProfit = b.net >= 0;

      /* Hero P&L card */
      els.overviewHero.innerHTML =
        '<div class="acct-hero ' + (isProfit ? 'profit' : 'loss') + '">' +
          '<div class="acct-hero-left">' +
            '<div class="acct-hero-eyebrow">Business net P&amp;L</div>' +
            '<div class="acct-hero-amount">฿' + fmtMoney(b.net) + '</div>' +
            '<div class="acct-hero-status">' +
              (isProfit
                ? '<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 17a7 7 0 100-14 7 7 0 000 14zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Profitable'
                : '<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg> In the red') +
            '</div>' +
          '</div>' +
          '<div class="acct-hero-right">' +
            '<div class="acct-hero-stat"><span class="acct-hero-stat-label">Income</span><span class="acct-hero-stat-val inc">฿' + fmtMoney(b.incomeTotal) + '</span></div>' +
            '<div class="acct-hero-stat"><span class="acct-hero-stat-label">Expenses</span><span class="acct-hero-stat-val exp">฿' + fmtMoney(b.expenseTotal) + '</span></div>' +
            '<div class="acct-hero-stat"><span class="acct-hero-stat-label">Items</span><span class="acct-hero-stat-val">' + b.incomeCount + ' in / ' + b.expenseCount + ' out</span></div>' +
          '</div>' +
        '</div>';

      /* KPI grid */
      const persLabel = p.incomeTotal > 0 || p.expenseTotal > 0
        ? '฿' + fmtMoney(p.incomeTotal) + ' in / ฿' + fmtMoney(p.expenseTotal) + ' out'
        : 'Nothing logged yet';
      els.overviewKpi.innerHTML =
        '<div class="acct-kpi kpi-income">' +
          '<div class="acct-kpi-label">Business income</div>' +
          '<div class="acct-kpi-value">฿' + fmtMoney(b.incomeTotal) + '</div>' +
          '<div class="acct-kpi-sub">' + b.incomeCount + ' line' + (b.incomeCount !== 1 ? 's' : '') + '</div>' +
        '</div>' +
        '<div class="acct-kpi kpi-expense">' +
          '<div class="acct-kpi-label">Business expenses</div>' +
          '<div class="acct-kpi-value">฿' + fmtMoney(b.expenseTotal) + '</div>' +
          '<div class="acct-kpi-sub">' + b.expenseCount + ' line' + (b.expenseCount !== 1 ? 's' : '') + '</div>' +
        '</div>' +
        '<div class="acct-kpi kpi-personal">' +
          '<div class="acct-kpi-label">Personal (tracked)</div>' +
          '<div class="acct-kpi-value" style="font-size:15px;margin-top:4px;color:var(--ink);">' + persLabel + '</div>' +
          '<div class="acct-kpi-sub">Not in business P&amp;L</div>' +
        '</div>';

      /* Ratio bar */
      const tot = b.incomeTotal + b.expenseTotal;
      const incPct = tot > 0 ? Math.round(b.incomeTotal / tot * 100) : 0;
      els.overviewRatio.innerHTML = tot > 0
        ? '<div class="acct-ratio-wrap">' +
            '<div class="acct-ratio-label">Income vs Expenses</div>' +
            '<div class="acct-ratio-bar"><div class="acct-ratio-fill" style="width:' + incPct + '%; background:' + (isProfit ? '#22c55e' : '#ef4444') + ';"></div></div>' +
            '<div class="acct-ratio-stats">' +
              '<span><strong>' + incPct + '%</strong> income (฿' + fmtMoney(b.incomeTotal) + ')</span>' +
              '<span><strong>' + (100 - incPct) + '%</strong> expenses (฿' + fmtMoney(b.expenseTotal) + ')</span>' +
            '</div>' +
          '</div>'
        : '';

      /* Deposit accounts */
      const dep = s.incomeByDepositAccount || {};
      const depKeys = Object.keys(dep).sort();
      if (!depKeys.length) {
        els.overviewDep.innerHTML = '';
      } else {
        let html = '<div class="acct-section-title">Income by deposit account</div><div class="acct-dep-grid">';
        depKeys.forEach(function (k) {
          const row = dep[k];
          html +=
            '<div class="acct-dep-card">' +
              '<div class="acct-dep-name">' + esc(DEP_ICONS[k] || '📦') + ' ' + esc(DEP_LABELS[k] || k) + '</div>' +
              '<div class="acct-dep-amount">฿' + fmtMoney(row.total) + '</div>' +
              '<div class="acct-dep-count">' + row.count + ' transaction' + (row.count !== 1 ? 's' : '') + '</div>' +
            '</div>';
        });
        html += '</div>';
        els.overviewDep.innerHTML = html;
      }
    }

    /* ─── Render a transaction row ─── */
    function makeTxRow(item, isInc, onEdit, onDel) {
      const cat = item.category || 'other';
      const color = catColor(cat, isInc);
      const labels = isInc ? INC_CAT_LABELS : EXP_CAT_LABELS;
      const title = isInc ? item.description : item.vendor;
      const scope = item.scope || 'business';

      const row = document.createElement('div');
      row.className = 'acct-tx';
      row.style.setProperty('--tx-color', color);

      /* accent bar */
      const accent = document.createElement('div');
      accent.className = 'acct-tx-accent';

      /* thumbnail */
      const thumb = document.createElement('div');
      thumb.className = 'acct-tx-thumb';
      if (item.imageFilename) {
        const img = document.createElement('img');
        img.src = '/api/' + (isInc ? 'income' : 'expenses') + '/' + encodeURIComponent(item.id) + '/file';
        img.alt = '';
        thumb.appendChild(img);
      } else {
        const icon = document.createElement('span');
        icon.className = 'acct-tx-thumb-icon';
        icon.textContent = isInc ? '💰' : '🧾';
        thumb.appendChild(icon);
      }

      /* main content */
      const main = document.createElement('div');
      main.className = 'acct-tx-main';

      const catLabel = labels[cat] || cat;
      /* pill uses hex + 18% alpha bg */
      const pillBg = hexAlpha(color, 18);

      let html =
        '<div class="acct-tx-top">' +
          '<span class="acct-tx-title">' + esc(title) + '</span>' +
          '<span class="acct-tx-amount">฿' + fmtMoney(item.amount) + '</span>' +
        '</div>' +
        '<div class="acct-tx-meta">' +
          '<span class="acct-tx-cat-pill" style="background:' + pillBg + ';color:' + color + ';">' + esc(catLabel) + '</span>' +
          '<span class="acct-tx-date">' + fmtDate(item.date) + '</span>' +
          '<span class="acct-tx-scope' + (scope === 'personal' ? ' personal' : '') + '">' + esc(SCOPE_LABEL[scope] || scope) + '</span>';
      if (isInc && item.depositAccount) {
        html += '<span class="acct-tx-scope">' + esc(DEP_LABELS[item.depositAccount] || item.depositAccount) + '</span>';
      }
      html += '</div>';
      if (item.notes) {
        html += '<div class="acct-tx-notes">' + esc(item.notes) + '</div>';
      }
      main.innerHTML = html;

      /* actions */
      const actions = document.createElement('div');
      actions.className = 'acct-tx-actions';
      const btnEdit = document.createElement('button');
      btnEdit.type = 'button'; btnEdit.className = 'btn btn-sm'; btnEdit.textContent = 'Edit';
      btnEdit.onclick = onEdit;
      const btnDel = document.createElement('button');
      btnDel.type = 'button'; btnDel.className = 'btn btn-sm'; btnDel.textContent = 'Del';
      btnDel.onclick = onDel;
      actions.appendChild(btnEdit);
      actions.appendChild(btnDel);

      row.appendChild(accent);
      row.appendChild(thumb);
      row.appendChild(main);
      row.appendChild(actions);
      return row;
    }

    /* ─── Load expenses ─── */
    async function loadExpenses() {
      const p = queryRange();
      if (els.filterExpCat.value) p.set('category', els.filterExpCat.value);
      if (els.filterExpScope.value) p.set('scope', els.filterExpScope.value);
      const res = await fetch('/api/expenses?' + p.toString());
      const data = await res.json();
      if (!res.ok) { showAlert(data.error || 'Failed to load expenses', true); return; }
      if (data.meta && data.meta.categories) {
        fillSelect(els.filterExpCat, data.meta.categories, EXP_CAT_LABELS);
        fillSelectRequired(els.fExpCategory, data.meta.categories, EXP_CAT_LABELS);
      }
      /* category chips */
      renderCatChips(els.expCats, data.meta && data.meta.byCategory, EXP_CAT_LABELS, EXP_CAT_COLORS, function (k) {
        els.filterExpCat.value = k;
        loadExpenses();
      });
      /* summary bar */
      const tot = data.meta && data.meta.total ? data.meta.total : 0;
      const sum = data.meta && data.meta.totalAmount ? data.meta.totalAmount : 0;
      els.expSummaryBar.innerHTML = tot
        ? '<span>' + tot + ' expense' + (tot !== 1 ? 's' : '') + '</span><strong>฿' + fmtMoney(sum) + ' total</strong>'
        : '';
      /* list */
      els.expList.innerHTML = '';
      const items = data.expenses || [];
      if (!items.length) {
        els.expList.innerHTML = emptyState('🧾', 'No expenses', 'Add your first expense with the button above.');
        return;
      }
      items.forEach(function (e) {
        els.expList.appendChild(makeTxRow(e, false,
          function () { openExpModal(e); },
          function () { delExpense(e.id); }
        ));
      });
    }

    /* ─── Load income ─── */
    async function loadIncomes() {
      const p = queryRange();
      if (els.filterIncCat.value) p.set('category', els.filterIncCat.value);
      if (els.filterIncDep.value) p.set('depositAccount', els.filterIncDep.value);
      if (els.filterIncScope.value) p.set('scope', els.filterIncScope.value);
      const res = await fetch('/api/income?' + p.toString());
      const data = await res.json();
      if (!res.ok) { showAlert(data.error || 'Failed to load income', true); return; }
      if (data.meta) {
        if (data.meta.categories) {
          fillSelect(els.filterIncCat, data.meta.categories, INC_CAT_LABELS);
          fillSelectRequired(els.fIncCategory, data.meta.categories, INC_CAT_LABELS);
        }
        if (data.meta.depositAccounts) {
          fillSelect(els.filterIncDep, data.meta.depositAccounts, DEP_LABELS);
          fillSelectRequired(els.fIncDeposit, data.meta.depositAccounts, DEP_LABELS);
        }
      }
      /* category chips */
      renderCatChips(els.incCats, data.meta && data.meta.byCategory, INC_CAT_LABELS, INC_CAT_COLORS, function (k) {
        els.filterIncCat.value = k;
        loadIncomes();
      });
      /* summary bar */
      const tot = data.meta && data.meta.total ? data.meta.total : 0;
      const sum = data.meta && data.meta.totalAmount ? data.meta.totalAmount : 0;
      els.incSummaryBar.innerHTML = tot
        ? '<span>' + tot + ' income line' + (tot !== 1 ? 's' : '') + '</span><strong>฿' + fmtMoney(sum) + ' total</strong>'
        : '';
      /* list */
      els.incList.innerHTML = '';
      const items = data.incomes || [];
      if (!items.length) {
        els.incList.innerHTML = emptyState('💰', 'No income', 'Add your first income line with the button above.');
        return;
      }
      items.forEach(function (e) {
        els.incList.appendChild(makeTxRow(e, true,
          function () { openIncModal(e); },
          function () { delIncome(e.id); }
        ));
      });
    }

    function refreshAll() { loadSummary(); loadExpenses(); loadIncomes(); }

    /* ─── Tabs ─── */
    function setTab(name) {
      activeTab = name;
      document.querySelectorAll('.acct-tab').forEach(function (t) {
        t.classList.toggle('active', t.getAttribute('data-tab') === name);
      });
      els.paneOverview.style.display = name === 'overview' ? 'block' : 'none';
      els.paneExp.style.display      = name === 'expenses' ? 'block' : 'none';
      els.paneInc.style.display      = name === 'income'   ? 'block' : 'none';
    }
    document.querySelectorAll('.acct-tab').forEach(function (t) {
      t.addEventListener('click', function () { setTab(t.getAttribute('data-tab')); });
    });

    /* ─── Modals ─── */
    function openExpModal(edit) {
      els.modalExp.style.display = 'flex';
      els.fExpFile.value = '';
      if (edit) {
        els.modalExpTitle.textContent = 'Edit expense';
        els.fExpId.value = edit.id;
        els.fExpDate.value = edit.date;
        els.fExpAmount.value = String(edit.amount);
        els.fExpVendor.value = edit.vendor;
        els.fExpCategory.value = edit.category;
        els.fExpScope.value = edit.scope === 'personal' ? 'personal' : 'business';
        els.fExpNotes.value = edit.notes || '';
      } else {
        els.modalExpTitle.textContent = 'Add expense';
        els.fExpId.value = '';
        els.fExpDate.value = new Date().toISOString().slice(0, 10);
        els.fExpAmount.value = '';
        els.fExpVendor.value = '';
        els.fExpCategory.selectedIndex = 0;
        els.fExpScope.value = 'business';
        els.fExpNotes.value = '';
      }
    }
    function closeExpModal() { els.modalExp.style.display = 'none'; }

    function openIncModal(edit) {
      els.modalInc.style.display = 'flex';
      els.fIncFile.value = '';
      if (edit) {
        els.modalIncTitle.textContent = 'Edit income';
        els.fIncId.value = edit.id;
        els.fIncDate.value = edit.date;
        els.fIncAmount.value = String(edit.amount);
        els.fIncDesc.value = edit.description;
        els.fIncCategory.value = edit.category;
        els.fIncDeposit.value = edit.depositAccount;
        els.fIncScope.value = edit.scope === 'personal' ? 'personal' : 'business';
        els.fIncNotes.value = edit.notes || '';
      } else {
        els.modalIncTitle.textContent = 'Add income';
        els.fIncId.value = '';
        els.fIncDate.value = new Date().toISOString().slice(0, 10);
        els.fIncAmount.value = '';
        els.fIncDesc.value = '';
        els.fIncCategory.selectedIndex = 0;
        els.fIncDeposit.selectedIndex = 0;
        els.fIncScope.value = 'business';
        els.fIncNotes.value = '';
      }
    }
    function closeIncModal() { els.modalInc.style.display = 'none'; }

    /* ─── Delete ─── */
    async function delExpense(id) {
      if (!confirm('Delete this expense?')) return;
      const res = await fetch('/api/expenses/' + encodeURIComponent(id), { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) { showAlert(data.error || 'Delete failed', true); return; }
      showAlert('Deleted'); refreshAll();
    }
    async function delIncome(id) {
      if (!confirm('Delete this income line?')) return;
      const res = await fetch('/api/income/' + encodeURIComponent(id), { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) { showAlert(data.error || 'Delete failed', true); return; }
      showAlert('Deleted'); refreshAll();
    }

    /* ─── File helper ─── */
    function readFileAsDataUrl(file) {
      return new Promise(function (resolve, reject) {
        var r = new FileReader();
        r.onload = function () { resolve(r.result); };
        r.onerror = reject;
        r.readAsDataURL(file);
      });
    }

    /* ─── Event wiring ─── */
    els.btnApply.onclick = refreshAll;
    els.btnClear.onclick = function () { els.filterFrom.value = ''; els.filterTo.value = ''; refreshAll(); };
    els.btnAddExp.onclick = function () { openExpModal(null); };
    els.btnAddInc.onclick = function () { openIncModal(null); };
    els.btnExpCancel.onclick = closeExpModal;
    els.btnIncCancel.onclick = closeIncModal;
    els.modalExp.onclick = function (ev) { if (ev.target === els.modalExp) closeExpModal(); };
    els.modalInc.onclick = function (ev) { if (ev.target === els.modalInc) closeIncModal(); };

    els.filterExpCat.onchange   = loadExpenses;
    els.filterExpScope.onchange = loadExpenses;
    els.filterIncCat.onchange   = loadIncomes;
    els.filterIncDep.onchange   = loadIncomes;
    els.filterIncScope.onchange = loadIncomes;

    /* ─── Form: expense ─── */
    els.formExp.onsubmit = async function (ev) {
      ev.preventDefault();
      var id = els.fExpId.value;
      var imageBase64;
      var file = els.fExpFile.files && els.fExpFile.files[0];
      if (file) {
        if (file.size > 6 * 1024 * 1024) { showAlert('Image must be under 6 MB', true); return; }
        imageBase64 = await readFileAsDataUrl(file);
      }
      var payload = {
        date: els.fExpDate.value,
        amount: Number(els.fExpAmount.value),
        vendor: els.fExpVendor.value,
        category: els.fExpCategory.value,
        scope: els.fExpScope.value,
        notes: els.fExpNotes.value,
        source: 'dashboard',
      };
      if (imageBase64) payload.imageBase64 = imageBase64;
      var res;
      if (id) {
        var patch = Object.assign({}, payload);
        if (!file) delete patch.imageBase64;
        res = await fetch('/api/expenses/' + encodeURIComponent(id), { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(patch) });
      } else {
        res = await fetch('/api/expenses', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      }
      var data = await res.json();
      if (!res.ok) { showAlert(data.error || 'Save failed', true); return; }
      closeExpModal(); showAlert('Saved'); refreshAll();
    };

    /* ─── Form: income ─── */
    els.formInc.onsubmit = async function (ev) {
      ev.preventDefault();
      var id = els.fIncId.value;
      var imageBase64;
      var file2 = els.fIncFile.files && els.fIncFile.files[0];
      if (file2) {
        if (file2.size > 6 * 1024 * 1024) { showAlert('Image must be under 6 MB', true); return; }
        imageBase64 = await readFileAsDataUrl(file2);
      }
      var payload2 = {
        date: els.fIncDate.value,
        amount: Number(els.fIncAmount.value),
        description: els.fIncDesc.value,
        category: els.fIncCategory.value,
        depositAccount: els.fIncDeposit.value,
        scope: els.fIncScope.value,
        notes: els.fIncNotes.value,
        source: 'dashboard',
      };
      if (imageBase64) payload2.imageBase64 = imageBase64;
      var res2;
      if (id) {
        var patch2 = Object.assign({}, payload2);
        if (!file2) delete patch2.imageBase64;
        res2 = await fetch('/api/income/' + encodeURIComponent(id), { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(patch2) });
      } else {
        res2 = await fetch('/api/income', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload2) });
      }
      var data2 = await res2.json();
      if (!res2.ok) { showAlert(data2.error || 'Save failed', true); return; }
      closeIncModal(); showAlert('Saved'); refreshAll();
    };

    /* ─── Boot ─── */
    refreshAll();
  </script>

  <!-- ═══════════ AI CHAT PANEL ═══════════ -->

  <!-- FAB -->
  <button class="acct-ai-fab" id="acct-ai-fab" title="AI Assistant — scan receipts &amp; ask questions">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M10 2l1.5 4.5H16l-3.6 2.6 1.4 4.4L10 11l-3.8 2.5 1.4-4.4L4 6.5h4.5L10 2z" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- Backdrop -->
  <div class="acct-chat-backdrop" id="acct-chat-backdrop"></div>

  <!-- Chat panel -->
  <div class="acct-chat-panel" id="acct-chat-panel">
    <div class="acct-chat-header">
      <div class="acct-chat-header-title">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M10 2l1.5 4.5H16l-3.6 2.6 1.4 4.4L10 11l-3.8 2.5 1.4-4.4L4 6.5h4.5L10 2z" stroke-linejoin="round"/>
        </svg>
        Accounting AI
      </div>
      <div class="acct-chat-header-actions">
        <button class="acct-chat-hdr-btn" id="acct-chat-clear-btn">Clear</button>
        <button class="acct-chat-hdr-btn" id="acct-chat-close-btn">&#x2715;</button>
      </div>
    </div>

    <!-- Welcome (shown only when no messages) -->
    <div id="acct-chat-welcome" class="acct-chat-welcome">
      <div class="acct-chat-welcome-icon">🧾</div>
      <div class="acct-chat-welcome-title">Receipt scanning &amp; P&amp;L</div>
      <div class="acct-chat-welcome-sub">Upload a receipt, bank notification or Wise screenshot and I'll log it. Or ask anything about your finances.</div>
      <div class="acct-chat-quick-btns">
        <button class="acct-chat-quick-btn" data-prompt="I have a receipt to scan">📷 Scan a receipt</button>
        <button class="acct-chat-quick-btn" data-prompt="I want to log an Airbnb payout">💳 Log Airbnb payout</button>
        <button class="acct-chat-quick-btn" data-prompt="Show me a P&amp;L summary for this month">📊 P&amp;L this month</button>
        <button class="acct-chat-quick-btn" data-prompt="What were my biggest expenses recently?">🔍 Biggest expenses</button>
      </div>
    </div>

    <!-- Messages -->
    <div class="acct-chat-messages" id="acct-chat-messages" style="display:none;"></div>

    <!-- Pending image preview -->
    <div class="acct-chat-img-preview" id="acct-chat-img-preview" style="display:none;">
      <div class="acct-chat-img-thumb-wrap">
        <img class="acct-chat-img-thumb" id="acct-chat-img-thumb" src="" alt="Receipt" />
        <button class="acct-chat-img-remove" id="acct-chat-img-remove" title="Remove image">&#x2715;</button>
      </div>
    </div>

    <!-- Input bar -->
    <div class="acct-chat-input-bar">
      <button class="acct-chat-attach-btn" id="acct-chat-attach-btn" title="Upload receipt / screenshot">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M14.5 11.5l-5 5a4.24 4.24 0 01-6-6l7-7a2.83 2.83 0 014 4l-7 7a1.41 1.41 0 01-2-2l5-5"/>
        </svg>
      </button>
      <input type="file" id="acct-chat-file-input" accept="image/*" style="display:none;" />
      <textarea
        class="acct-chat-textarea"
        id="acct-chat-textarea"
        placeholder="Ask a question or describe an expense…"
        rows="1"
      ></textarea>
      <button class="acct-chat-send-btn" id="acct-chat-send-btn" disabled title="Send">
        <svg viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
        </svg>
      </button>
    </div>
  </div>

  <script is:inline>
  (function () {
    /* ─── State ─── */
    var chatHistory = [];     // [{role, content}]
    var pendingImage = null;  // { dataUrl, mimeType }
    var isStreaming = false;
    var needsRefresh = false; // set when AI calls create_expense / create_income

    /* ─── DOM ─── */
    var panel     = document.getElementById('acct-chat-panel');
    var backdrop  = document.getElementById('acct-chat-backdrop');
    var welcome   = document.getElementById('acct-chat-welcome');
    var msgList   = document.getElementById('acct-chat-messages');
    var imgPrev   = document.getElementById('acct-chat-img-preview');
    var imgThumb  = document.getElementById('acct-chat-img-thumb');
    var fileInput = document.getElementById('acct-chat-file-input');
    var textarea  = document.getElementById('acct-chat-textarea');
    var sendBtn   = document.getElementById('acct-chat-send-btn');

    /* ─── Open / Close ─── */
    function openChat() {
      panel.classList.add('open');
      backdrop.classList.add('visible');
      textarea.focus();
    }
    function closeChat() {
      panel.classList.remove('open');
      backdrop.classList.remove('visible');
      if (needsRefresh && typeof refreshAll === 'function') {
        refreshAll();
        needsRefresh = false;
      }
    }

    document.getElementById('acct-ai-fab').onclick = openChat;
    document.getElementById('btn-ai-open').onclick  = openChat;
    document.getElementById('acct-chat-close-btn').onclick = closeChat;
    backdrop.onclick = closeChat;

    document.getElementById('acct-chat-clear-btn').onclick = function () {
      chatHistory = [];
      pendingImage = null;
      imgPrev.style.display = 'none';
      showWelcome();
    };

    /* ─── Welcome helpers ─── */
    function showWelcome() {
      welcome.style.display = 'flex';
      msgList.style.display = 'none';
    }
    function hideWelcome() {
      welcome.style.display = 'none';
      msgList.style.display = 'flex';
    }

    /* ─── Quick-action buttons ─── */
    document.querySelectorAll('.acct-chat-quick-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var prompt = btn.getAttribute('data-prompt');
        if (prompt) sendMessage(prompt, null);
      });
    });

    /* ─── Image attach ─── */
    document.getElementById('acct-chat-attach-btn').onclick = function () {
      fileInput.click();
    };
    fileInput.onchange = function () {
      var file = fileInput.files && fileInput.files[0];
      if (!file) return;
      if (file.size > 8 * 1024 * 1024) {
        alert('Image must be under 8 MB');
        return;
      }
      var reader = new FileReader();
      reader.onload = function () {
        pendingImage = { dataUrl: reader.result, mimeType: file.type };
        imgThumb.src = reader.result;
        imgPrev.style.display = 'block';
        updateSendBtn();
      };
      reader.readAsDataURL(file);
      fileInput.value = '';
    };
    document.getElementById('acct-chat-img-remove').onclick = function () {
      pendingImage = null;
      imgPrev.style.display = 'none';
      updateSendBtn();
    };

    /* ─── Drag & drop receipt onto panel ─── */
    panel.addEventListener('dragover', function (e) { e.preventDefault(); });
    panel.addEventListener('drop', function (e) {
      e.preventDefault();
      var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (!file || !file.type.startsWith('image/')) return;
      var reader = new FileReader();
      reader.onload = function () {
        pendingImage = { dataUrl: reader.result, mimeType: file.type };
        imgThumb.src = reader.result;
        imgPrev.style.display = 'block';
        updateSendBtn();
      };
      reader.readAsDataURL(file);
    });

    /* ─── Textarea auto-resize + send on Enter ─── */
    textarea.addEventListener('input', function () {
      textarea.style.height = 'auto';
      textarea.style.height = Math.min(textarea.scrollHeight, 100) + 'px';
      updateSendBtn();
    });
    textarea.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (!sendBtn.disabled) doSend();
      }
    });

    sendBtn.onclick = doSend;

    function updateSendBtn() {
      sendBtn.disabled = isStreaming || (!textarea.value.trim() && !pendingImage);
    }

    /* ─── Simple markdown renderer ─── */
    function renderMd(text) {
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\n/g, '<br>');
    }

    /* ─── Append a message bubble ─── */
    function appendMsg(role, html, imgDataUrl) {
      var div = document.createElement('div');
      div.className = 'acct-chat-msg ' + role;
      if (imgDataUrl) {
        var img = document.createElement('img');
        img.src = imgDataUrl;
        img.className = 'acct-chat-msg-img';
        div.appendChild(img);
      }
      var span = document.createElement('span');
      span.innerHTML = html;
      div.appendChild(span);
      msgList.appendChild(div);
      msgList.scrollTop = msgList.scrollHeight;
      return div;
    }

    function appendToolBadge(toolName) {
      var LABELS = {
        create_expense: '✓ Logged expense',
        create_income:  '✓ Logged income',
        get_accounting_summary: '📊 Fetched P&L',
        list_recent_accounting: '📋 Fetched recent entries',
      };
      var div = document.createElement('div');
      div.className = 'acct-chat-tool-badge';
      div.innerHTML = '<svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2l1.5 4.5H16l-3.6 2.6 1.4 4.4L10 11l-3.8 2.5 1.4-4.4L4 6.5h4.5L10 2z"/></svg>' + (LABELS[toolName] || toolName);
      msgList.appendChild(div);
      msgList.scrollTop = msgList.scrollHeight;
    }

    function appendThinking() {
      var div = document.createElement('div');
      div.className = 'acct-chat-thinking';
      div.innerHTML = '<div class="acct-chat-thinking-dots"><span></span><span></span><span></span></div>';
      msgList.appendChild(div);
      msgList.scrollTop = msgList.scrollHeight;
      return div;
    }

    /* ─── Send ─── */
    function doSend() {
      var text = textarea.value.trim();
      if (!text && !pendingImage) return;
      sendMessage(text, pendingImage);
      textarea.value = '';
      textarea.style.height = 'auto';
      pendingImage = null;
      imgPrev.style.display = 'none';
    }

    async function sendMessage(text, image) {
      hideWelcome();
      isStreaming = true;
      updateSendBtn();

      /* Build user message content */
      var imgDataUrl = image ? image.dataUrl : null;
      if (image) {
        /* multi-part */
        appendMsg('user', text ? renderMd(text) : 'Here is a receipt:', imgDataUrl);
        var content = [];
        if (text) content.push({ type: 'text', text: text });
        content.push({ type: 'image_url', image_url: { url: image.dataUrl, detail: 'high' } });
        chatHistory.push({ role: 'user', content: content });
      } else {
        appendMsg('user', renderMd(text));
        chatHistory.push({ role: 'user', content: text });
      }

      /* Thinking indicator */
      var thinkDiv = appendThinking();

      /* AI bubble we'll stream into */
      var aiBubble = null;
      var aiText = '';

      try {
        var res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: chatHistory }),
        });

        if (!res.ok) {
          thinkDiv.remove();
          appendMsg('ai', 'Sorry, something went wrong. Please try again.');
          isStreaming = false;
          updateSendBtn();
          return;
        }

        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        var buf = '';

        while (true) {
          var chunk = await reader.read();
          if (chunk.done) break;
          buf += decoder.decode(chunk.value, { stream: true });
          var lines = buf.split('\n');
          buf = lines.pop();

          for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (!line.startsWith('data:')) continue;
            var raw = line.slice(5).trim();
            if (raw === '[DONE]') break;
            var evt;
            try { evt = JSON.parse(raw); } catch { continue; }

            if (evt.type === 'delta') {
              thinkDiv.remove(); thinkDiv = null;
              if (!aiBubble) {
                aiBubble = document.createElement('div');
                aiBubble.className = 'acct-chat-msg ai';
                var span = document.createElement('span');
                aiBubble.appendChild(span);
                msgList.appendChild(aiBubble);
              }
              aiText += evt.content;
              aiBubble.querySelector('span').innerHTML = renderMd(aiText);
              msgList.scrollTop = msgList.scrollHeight;
            } else if (evt.type === 'tool') {
              if (thinkDiv) { thinkDiv.remove(); thinkDiv = null; }
              appendToolBadge(evt.name);
              if (evt.name === 'create_expense' || evt.name === 'create_income') {
                needsRefresh = true;
              }
              /* New thinking indicator for continued processing */
              thinkDiv = appendThinking();
            } else if (evt.type === 'done') {
              if (thinkDiv) { thinkDiv.remove(); thinkDiv = null; }
            } else if (evt.type === 'error') {
              if (thinkDiv) { thinkDiv.remove(); thinkDiv = null; }
              appendMsg('ai', evt.content || 'Something went wrong.');
            }
          }
        }

        if (thinkDiv) thinkDiv.remove();
        if (aiText) chatHistory.push({ role: 'assistant', content: aiText });

        /* If AI logged data, show a refresh notice */
        if (needsRefresh && aiBubble) {
          var notice = document.createElement('div');
          notice.className = 'acct-chat-success';
          notice.innerHTML = '<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Entry saved — ledger will refresh when you close this panel.';
          msgList.appendChild(notice);
          msgList.scrollTop = msgList.scrollHeight;
        }
      } catch (err) {
        if (thinkDiv) thinkDiv.remove();
        appendMsg('ai', 'Network error. Please check your connection.');
      }

      isStreaming = false;
      updateSendBtn();
    }
  }());
  </script>
</BaseLayout>

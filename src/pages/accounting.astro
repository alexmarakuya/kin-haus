---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppNav from '../components/AppNav.astro';
import '../styles/dashboard.css';
---

<BaseLayout title="Kin Haus — Accounting">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content">
  <meta name="theme-color" content="#2c6e49">

  <style is:global>
    /* ─── Accounting page layout ─── */
    .acct-body {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px 28px 80px;
    }

    /* ─── Sticky filter bar ─── */
    .acct-filter-bar {
      position: sticky;
      top: 60px;
      z-index: 30;
      background: var(--bg, #f5f4f1);
      border-bottom: 1px solid #e4e2de;
      padding: 10px 0;
      margin-bottom: 0;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .acct-filter-bar .filter-label {
      font-size: 12px;
      color: var(--muted);
    }
    .acct-date-input {
      border: 1px solid #d8d6d0;
      border-radius: 6px;
      background: #fff;
      font-size: 13px;
      padding: 6px 10px;
      color: var(--ink);
      outline: none;
      transition: border-color .15s;
    }
    .acct-date-input:focus { border-color: var(--accent, #2c6e49); }

    /* ─── Tabs ─── */
    .acct-tabs {
      display: flex;
      gap: 4px;
      padding: 16px 0 0;
      border-bottom: 2px solid #e4e2de;
      margin-bottom: 24px;
    }
    .acct-tab {
      padding: 8px 18px;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
      cursor: pointer;
      border-radius: 8px 8px 0 0;
      border: 1px solid transparent;
      border-bottom: none;
      transition: all .15s;
      position: relative;
      bottom: -2px;
      background: transparent;
    }
    .acct-tab:hover { color: var(--ink); background: #f0ede8; }
    .acct-tab.active {
      color: var(--ink);
      background: var(--bg, #f5f4f1);
      border-color: #e4e2de;
      font-weight: 600;
    }

    /* ─── Hero P&L card ─── */
    .acct-hero {
      border-radius: 16px;
      padding: 28px 32px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      background: var(--card-bg, #fff);
      border: 1px solid #e8e8e4;
      overflow: hidden;
      position: relative;
    }
    .acct-hero::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
    }
    .acct-hero.profit::before { background: #22c55e; }
    .acct-hero.loss::before { background: #ef4444; }
    .acct-hero-left {}
    .acct-hero-eyebrow {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      margin-bottom: 6px;
      font-weight: 600;
    }
    .acct-hero-amount {
      font-size: 48px;
      font-weight: 700;
      letter-spacing: -.02em;
      line-height: 1;
      margin-bottom: 8px;
      font-variant-numeric: tabular-nums;
    }
    .acct-hero.profit .acct-hero-amount { color: #16a34a; }
    .acct-hero.loss .acct-hero-amount { color: #dc2626; }
    .acct-hero-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 100px;
    }
    .acct-hero.profit .acct-hero-status { background: #dcfce7; color: #16a34a; }
    .acct-hero.loss .acct-hero-status { background: #fee2e2; color: #dc2626; }
    .acct-hero-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
      min-width: 180px;
    }
    .acct-hero-stat {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
    }
    .acct-hero-stat-label { color: var(--muted); }
    .acct-hero-stat-val { font-weight: 600; font-variant-numeric: tabular-nums; }
    .acct-hero-stat-val.inc { color: #16a34a; }
    .acct-hero-stat-val.exp { color: #dc2626; }

    /* ─── Ratio bar ─── */
    .acct-ratio-wrap {
      background: var(--card-bg, #fff);
      border: 1px solid #e8e8e4;
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 16px;
    }
    .acct-ratio-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--muted);
      margin-bottom: 10px;
      font-weight: 600;
    }
    .acct-ratio-bar {
      height: 10px;
      border-radius: 100px;
      background: #f0ede8;
      overflow: hidden;
      margin-bottom: 8px;
    }
    .acct-ratio-fill {
      height: 100%;
      background: #22c55e;
      border-radius: 100px;
      transition: width .4s ease;
    }
    .acct-ratio-stats {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--muted);
    }
    .acct-ratio-stats span strong { color: var(--ink); }

    /* ─── KPI grid (smaller cards below hero) ─── */
    .acct-kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }
    .acct-kpi {
      background: var(--card-bg, #fff);
      border: 1px solid #e8e8e4;
      border-radius: 12px;
      padding: 16px 18px;
      position: relative;
      overflow: hidden;
    }
    .acct-kpi::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .acct-kpi.kpi-income::before { background: #22c55e; }
    .acct-kpi.kpi-expense::before { background: #ef4444; }
    .acct-kpi.kpi-personal::before { background: #a78bfa; }
    .acct-kpi-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--muted);
      margin-bottom: 8px;
      font-weight: 600;
    }
    .acct-kpi-value {
      font-size: 22px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      margin-bottom: 4px;
    }
    .acct-kpi.kpi-income .acct-kpi-value { color: #16a34a; }
    .acct-kpi.kpi-expense .acct-kpi-value { color: #dc2626; }
    .acct-kpi-sub {
      font-size: 11px;
      color: #aaa;
    }

    /* ─── Deposit account pills ─── */
    .acct-deposits-section {
      margin-top: 16px;
    }
    .acct-section-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      font-weight: 600;
      margin-bottom: 10px;
    }
    .acct-dep-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 8px;
    }
    .acct-dep-card {
      background: var(--card-bg, #fff);
      border: 1px solid #e8e8e4;
      border-radius: 10px;
      padding: 12px 14px;
    }
    .acct-dep-name {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .acct-dep-amount {
      font-size: 16px;
      font-weight: 700;
      color: #16a34a;
      font-variant-numeric: tabular-nums;
    }
    .acct-dep-count {
      font-size: 11px;
      color: #bbb;
      margin-top: 2px;
    }

    /* ─── Category chips ─── */
    .acct-cat-section {
      margin-bottom: 20px;
    }
    .acct-cat-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .acct-cat-chip {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 6px 12px;
      border-radius: 100px;
      border: 1.5px solid transparent;
      cursor: pointer;
      font-size: 12px;
      font-weight: 500;
      transition: all .15s;
      background: var(--card-bg, #fff);
      user-select: none;
    }
    .acct-cat-chip:hover { opacity: .8; }
    .acct-cat-chip.selected { box-shadow: 0 0 0 2px var(--chip-color); }
    .acct-chip-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--chip-color);
      flex-shrink: 0;
    }
    .acct-chip-label { color: var(--ink); }
    .acct-chip-amount {
      font-weight: 700;
      color: var(--chip-color);
      font-variant-numeric: tabular-nums;
    }

    /* ─── Pane filter bar ─── */
    .acct-pane-filters {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid #eae8e5;
    }

    /* ─── Summary bar above list ─── */
    .acct-list-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 12px;
      color: var(--muted);
    }
    .acct-list-summary strong {
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }

    /* ─── Transaction rows ─── */
    .acct-tx-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .acct-tx {
      display: flex;
      align-items: flex-start;
      gap: 0;
      background: var(--card-bg, #fff);
      border: 1px solid #e8e8e4;
      border-radius: 10px;
      overflow: hidden;
      transition: box-shadow .12s;
    }
    .acct-tx:hover { box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    .acct-tx-accent {
      width: 4px;
      flex-shrink: 0;
      background: var(--tx-color, #9ca3af);
      align-self: stretch;
      min-height: 52px;
    }
    .acct-tx-thumb {
      width: 54px;
      height: 54px;
      flex-shrink: 0;
      background: #f5f4f1;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      margin: 10px 0 10px 10px;
      border-radius: 8px;
    }
    .acct-tx-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .acct-tx-thumb-icon {
      font-size: 20px;
      line-height: 1;
    }
    .acct-tx-main {
      flex: 1;
      min-width: 0;
      padding: 12px 14px;
    }
    .acct-tx-top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 6px;
    }
    .acct-tx-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .acct-tx-amount {
      font-size: 16px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      color: var(--tx-color, #444);
      flex-shrink: 0;
    }
    .acct-tx-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .acct-tx-cat-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 100px;
    }
    .acct-tx-date {
      font-size: 12px;
      color: var(--muted);
    }
    .acct-tx-scope {
      font-size: 11px;
      color: var(--muted);
      background: #f0ede8;
      border-radius: 100px;
      padding: 2px 7px;
    }
    .acct-tx-scope.personal { background: #f3f0ff; color: #7c3aed; }
    .acct-tx-notes {
      font-size: 12px;
      color: var(--muted);
      margin-top: 4px;
      font-style: italic;
    }
    .acct-tx-actions {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 10px 12px 10px 4px;
      flex-shrink: 0;
      align-self: center;
    }

    /* ─── Empty state ─── */
    .acct-empty {
      text-align: center;
      padding: 48px 24px;
      color: var(--muted);
    }
    .acct-empty-icon {
      font-size: 40px;
      margin-bottom: 12px;
      opacity: .5;
    }
    .acct-empty-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .acct-empty-sub {
      font-size: 13px;
    }

    /* ─── Hint box ─── */
    .acct-hint {
      font-size: 12px;
      color: var(--muted, #8b8b85);
      line-height: 1.6;
      margin: 0 0 20px;
      padding: 12px 16px;
      background: #f7f6f3;
      border-radius: 8px;
      border-left: 3px solid #d4d0c8;
    }

    /* ─── AI Chat FAB ─── */
    .acct-ai-fab {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 100;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: linear-gradient(135deg, #2c6e49, #1b4332);
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 18px rgba(44,110,73,.45);
      transition: transform .15s, box-shadow .15s;
    }
    .acct-ai-fab:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(44,110,73,.55); }
    .acct-ai-fab svg { width: 22px; height: 22px; }

    /* ─── AI chat panel ─── */
    .acct-chat-panel {
      position: fixed;
      top: 0; right: 0; bottom: 0;
      width: 400px;
      max-width: 100vw;
      background: var(--bg, #f5f4f1);
      border-left: 1px solid #e4e2de;
      box-shadow: -6px 0 30px rgba(0,0,0,.12);
      z-index: 110;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform .25s cubic-bezier(.4,0,.2,1);
    }
    .acct-chat-panel.open { transform: translateX(0); }

    .acct-chat-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid #e4e2de;
      background: #fff;
      flex-shrink: 0;
    }
    .acct-chat-header-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 14px;
    }
    .acct-chat-header-title svg { width: 18px; height: 18px; color: #2c6e49; }
    .acct-chat-header-actions { display: flex; gap: 6px; }
    .acct-chat-hdr-btn {
      background: none;
      border: 1px solid #e4e2de;
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 12px;
      color: var(--muted);
      cursor: pointer;
      transition: all .12s;
    }
    .acct-chat-hdr-btn:hover { background: #f0ede8; color: var(--ink); }

    /* ─── Welcome splash ─── */
    .acct-chat-welcome {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 24px;
      text-align: center;
    }
    .acct-chat-welcome-icon { font-size: 44px; margin-bottom: 14px; }
    .acct-chat-welcome-title { font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 8px; }
    .acct-chat-welcome-sub { font-size: 13px; color: var(--muted); line-height: 1.55; margin-bottom: 24px; max-width: 280px; }
    .acct-chat-quick-btns { display: flex; flex-direction: column; gap: 8px; width: 100%; max-width: 260px; }
    .acct-chat-quick-btn {
      background: #fff;
      border: 1px solid #e4e2de;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 13px;
      color: var(--ink);
      cursor: pointer;
      text-align: left;
      transition: all .12s;
    }
    .acct-chat-quick-btn:hover { background: #f0ede8; border-color: #2c6e49; }

    /* ─── Messages ─── */
    .acct-chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .acct-chat-msg {
      max-width: 88%;
      font-size: 13px;
      line-height: 1.55;
    }
    .acct-chat-msg.user {
      align-self: flex-end;
      background: #2c6e49;
      color: #fff;
      padding: 9px 13px;
      border-radius: 14px 14px 3px 14px;
    }
    .acct-chat-msg.ai {
      align-self: flex-start;
      background: #fff;
      border: 1px solid #e8e8e4;
      padding: 10px 13px;
      border-radius: 3px 14px 14px 14px;
      color: var(--ink);
    }
    .acct-chat-msg.ai strong { font-weight: 700; }
    .acct-chat-msg.ai code {
      background: #f0ede8;
      border-radius: 4px;
      padding: 1px 5px;
      font-size: 12px;
      font-family: 'JetBrains Mono', monospace;
    }
    .acct-chat-msg-img {
      max-width: 200px;
      border-radius: 8px;
      margin-bottom: 6px;
      display: block;
    }
    .acct-chat-tool-badge {
      align-self: flex-start;
      font-size: 11px;
      color: #2c6e49;
      background: #dcfce7;
      border-radius: 100px;
      padding: 3px 9px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .acct-chat-thinking {
      align-self: flex-start;
      font-size: 12px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .acct-chat-thinking-dots span {
      display: inline-block;
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--muted);
      animation: chatDot 1.2s infinite;
    }
    .acct-chat-thinking-dots span:nth-child(2) { animation-delay: .2s; }
    .acct-chat-thinking-dots span:nth-child(3) { animation-delay: .4s; }
    @keyframes chatDot {
      0%,80%,100% { opacity: .25; transform: scale(.8); }
      40% { opacity: 1; transform: scale(1); }
    }

    /* ─── Success card (after AI logs entry) ─── */
    .acct-chat-success {
      align-self: flex-start;
      background: #dcfce7;
      border: 1px solid #bbf7d0;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 12px;
      color: #166534;
      display: flex;
      align-items: center;
      gap: 8px;
      max-width: 88%;
    }

    /* ─── Image preview in input bar ─── */
    .acct-chat-img-preview {
      padding: 8px 12px 0;
      flex-shrink: 0;
    }
    .acct-chat-img-thumb-wrap {
      position: relative;
      display: inline-block;
    }
    .acct-chat-img-thumb {
      width: 60px;
      height: 60px;
      border-radius: 8px;
      object-fit: cover;
      border: 2px solid #2c6e49;
    }
    .acct-chat-img-remove {
      position: absolute;
      top: -6px; right: -6px;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: #ef4444;
      color: #fff;
      border: none;
      font-size: 11px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    /* ─── Input bar ─── */
    .acct-chat-input-bar {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      padding: 10px 12px 14px;
      border-top: 1px solid #e4e2de;
      background: #fff;
      flex-shrink: 0;
    }
    .acct-chat-attach-btn {
      background: none;
      border: 1px solid #d8d6d0;
      border-radius: 8px;
      width: 36px; height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      color: var(--muted);
      transition: all .12s;
    }
    .acct-chat-attach-btn:hover { background: #f0ede8; color: var(--ink); border-color: #2c6e49; }
    .acct-chat-attach-btn svg { width: 16px; height: 16px; }
    .acct-chat-textarea {
      flex: 1;
      resize: none;
      border: 1px solid #d8d6d0;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 13px;
      font-family: inherit;
      color: var(--ink);
      background: var(--bg, #f5f4f1);
      outline: none;
      min-height: 36px;
      max-height: 100px;
      line-height: 1.4;
      transition: border-color .15s;
    }
    .acct-chat-textarea:focus { border-color: #2c6e49; background: #fff; }
    .acct-chat-send-btn {
      background: #2c6e49;
      border: none;
      border-radius: 8px;
      width: 36px; height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      color: #fff;
      transition: all .12s;
    }
    .acct-chat-send-btn:disabled { background: #c8c4bc; cursor: not-allowed; }
    .acct-chat-send-btn:not(:disabled):hover { background: #1b4332; }
    .acct-chat-send-btn svg { width: 16px; height: 16px; }

    /* ─── Backdrop ─── */
    .acct-chat-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.25);
      z-index: 105;
      display: none;
    }
    .acct-chat-backdrop.visible { display: block; }

    @media (max-width: 640px) {
      .acct-body { padding: 14px 14px 60px; }
      .acct-hero-amount { font-size: 36px; }
